# ─────────────────────────────────────────────────────────────────────────────
# SurgeryScreen Lite configuration
# Copy this file to `.env.local` (development) or set these in your host's
# environment (production).
# ─────────────────────────────────────────────────────────────────────────────

# The admin password. Anyone with it can change what your screen shows, so
# make it long. The admin stays locked until it's set.
ADMIN_PASSWORD=

# Secret used to sign the sign-in cookie: a long random string, e.g.
# `openssl rand -hex 32`. Changing it signs everyone out.
SESSION_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# sqlite (default) stores everything in a single file under DATA_DIR.
# postgres uses a connection string instead.
# Leave DATABASE_DRIVER unset to auto-detect: if a Postgres connection string is
# present (DATABASE_URL / POSTGRES_URL, e.g. injected by Neon or Supabase)
# Postgres is used automatically, otherwise SQLite.
# DATABASE_DRIVER=sqlite
# DATABASE_URL=postgres://user:pass@host:5432/surgeryscreen?sslmode=require

# PEM certificate of the CA behind the Postgres server. When set, the server's
# certificate is verified; otherwise remote connections are encrypted but not
# verified.
# DATABASE_CA_CERT=

# NOTE: serverless hosts (Vercel, Netlify, Lambda) have no persistent disk, so
# sqlite + local storage will NOT work there — use Postgres + s3 below.

# ── Image storage ───────────────────────────────────────────────────────────
# local (default) writes uploads to DATA_DIR/blobs.
# s3 uses any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2…).
STORAGE_DRIVER=local

# Root directory for the SQLite file and locally stored images.
DATA_DIR=./data

# Required only when STORAGE_DRIVER=s3
# S3_BUCKET=surgeryscreen
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Optional public/CDN base URL. If set, images are served directly from here
# instead of being proxied through the app.
# S3_PUBLIC_URL=https://cdn.example.com

# Maximum upload size per image, in megabytes.
MAX_UPLOAD_MB=25

# Public base URL of this deployment (no trailing slash), for the copyable
# screen address in the editor. When unset, it uses whatever address the admin
# is opened on.
# SITE_URL=https://screen.example.org
